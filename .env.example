# Frontend public configuration (never put a service-role key here).
VITE_API_URL=/api
VITE_SUPABASE_PUBLISHABLE_KEY=
# GitHub repository Pages path, e.g. /soul-arcana/
VITE_BASE_PATH=/
# Optional full public site URL, including repository path.
VITE_PUBLIC_URL=

# Only used by local development and tests.
PORT=8788
